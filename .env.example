# Optional registry image override; local default is homeboard-tv-build:local.
# BUILD_IMAGE=registry.example/homeboard-tv-build:version
# dev/container.sh detects UID/GID, including rootless Docker's mapping.
# BUILD_UID=1000
# BUILD_GID=1000
# Durable debug key directory, mounted read-only; must contain debug.keystore.
# HOMEBOARD_DEBUG_SIGNING_DIR=/path/to/homeboard-debug-signing
