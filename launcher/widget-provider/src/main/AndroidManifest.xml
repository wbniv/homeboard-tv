<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-feature android:name="android.software.leanback" android:required="false" />
 <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
 <application android:label="Homeboard Widget Provider Test" android:allowBackup="false" android:icon="@drawable/census_icon" android:banner="@drawable/census_banner" android:theme="@android:style/Theme.Material.NoActionBar">
  <receiver android:name=".ProbeProvider" android:exported="true">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/probe_widget" />
  </receiver>
  <receiver android:name=".ConfiguredProvider" android:label="Required configuration test" android:exported="true">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/configured_widget" />
  </receiver>
  <activity android:name=".ConfigureActivity" android:exported="true" android:screenOrientation="landscape" />
  <activity android:name=".ProviderActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>
