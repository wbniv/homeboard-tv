<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/airQualityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/air_quality_card"
            android:nextFocusDown="@+id/grid"
            android:nextFocusUp="@+id/btnSettings">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/airQualityStation" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#CCDDEE" android:textSize="13sp" />
                <TextView android:id="@+id/airQualityValue" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="26sp" />
            </LinearLayout>
            <TextView android:id="@+id/airQualityDetail" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#CCDDEE" android:textSize="12sp"
                android:layout_marginStart="20dp" />
        </LinearLayout>
