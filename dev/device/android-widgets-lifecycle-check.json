  "app": "homeboard-widget-lifecycle",
  "duration": 150,
  "panel": "require-hidden",
  "input_script": [
    {
      "at": 8,
      "capture": "lifecycle-two-instances"
    },
    {
      "at": 30,
      "capture": "lifecycle-progress"
    },
    {
